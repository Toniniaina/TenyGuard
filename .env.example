# Application Settings
PROJECT_NAME="TenyGuard"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenyguard_db"

# Speech-To-Text (STT) Settings
